{
  "name": "versioned-product-knowledge-portal",
  "version": "0.2.0",
  "description": "Static-first product documentation portal with version-aware search and evidence-backed answers.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.19.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types:sync": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro sync",
    "lint": "pnpm types:sync && eslint . --max-warnings 0",
    "typecheck": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "evaluate:search": "tsx tools/evaluate-search.ts",
    "validate:links": "tsx tools/validate-links.ts",
    "validate:headers": "tsx tools/update-symbol-index.ts --check",
    "update:headers": "tsx tools/update-symbol-index.ts",
    "validate": "pnpm format:check && pnpm validate:headers && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm validate:links && pnpm evaluate:search",
    "native:build": "node tools/package-native.mjs",
    "native:test": "node desktop/tests/native-acceptance.mjs",
    "native:test:startup": "node desktop/tests/fatal-startup.mjs"
  },
  "dependencies": {
    "astro": "7.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "cross-env": "10.1.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
