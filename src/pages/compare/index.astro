---
/**
 * Offer a product-bound comparison chooser and no-JavaScript links to generated edition pairs.
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - variable topics: line 16
 * - variable choices: line 17
 * - variable serialized: line 21
 * @@SYMBOL_INDEX_END
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PRODUCTS } from "../../data/products";
import { toTopicDocument } from "../../lib/content";
import { comparisonRequests, comparisonUrl } from "../../lib/comparison";
const topics = (await getCollection("topics")).map(toTopicDocument);
const choices = comparisonRequests(topics, PRODUCTS).map((request) => ({
  ...request,
  url: comparisonUrl(request),
}));
const serialized = JSON.stringify(choices).replaceAll("<", "\\u003c");
---

<BaseLayout
  title="Compare documentation editions"
  description="Choose a product, two versions and a stable topic to compare source text, warnings and applicability."
>
  <section class="page-intro">
    <p class="eyebrow">Version review</p>
    <h1>Compare documentation editions</h1>
    <p class="lead">
      See exactly what the selected editions document. Procedures remain separate; missing text is
      not invented.
    </p>
  </section>
  <section class="content-section">
    <form data-comparison-form class="comparison-controls" aria-label="Choose edition comparison">
      <label>
        Comparison product
        <select name="product" data-compare-product>
          {PRODUCTS.map((product) => (
            <option value={product.id}>{product.name}</option>
          ))}
        </select>
      </label>
      <label>
        From version<select name="from" data-compare-from></select>
      </label>
      <label>
        To version<select name="to" data-compare-to></select>
      </label>
      <label>
        Topic identity<select name="slug" data-compare-slug></select>
      </label>
      <button class="button button-primary" type="submit">
        Compare editions
      </button>
      <p data-comparison-status role="status">
        Choose two versions of one product.
      </p>
    </form>
    <script
      is:inline
      type="application/json"
      data-comparison-choices
      set:html={serialized}
    ></script>
    <noscript>
      <h2>Direct comparison links</h2>
      <ul>
        {choices.map((choice) => (
          <li>
            <a href={choice.url}>
              {choice.productId}: {choice.from} to {choice.to}, {choice.slug}
            </a>
          </li>
        ))}
      </ul>
    </noscript>
  </section>
</BaseLayout>
<script>
  import { initializeComparisonChooser } from "../../components/comparison-chooser";
  const form = document.querySelector<HTMLFormElement>("[data-comparison-form]");
  const source = document.querySelector("[data-comparison-choices]");
  if (form && source?.textContent) initializeComparisonChooser(form, source.textContent);
</script>
