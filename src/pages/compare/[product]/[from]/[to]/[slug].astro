---
/**
 * Generate shareable static comparisons with explicit missing editions, warning changes and cited source columns.
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - interface Props: line 22
 * - function getStaticPaths: line 26
 * - variable statusLabels: line 35
 * @@SYMBOL_INDEX_END
 */
import { getCollection } from "astro:content";
import { PRODUCTS } from "../../../../../data/products";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import ComparisonEdition from "../../../../../components/ComparisonEdition.astro";
import { toTopicDocument } from "../../../../../lib/content";
import {
  compareTopics,
  comparisonRequests,
  comparisonUrl,
  type TopicComparison,
} from "../../../../../lib/comparison";
interface Props {
  comparison: TopicComparison;
}
/** Emit the union of actual topic identities across each known pair of versions. */
export async function getStaticPaths() {
  const topics = (await getCollection("topics")).map(toTopicDocument);
  return comparisonRequests(topics, PRODUCTS).map((request) => ({
    params: { product: request.productId, from: request.from, to: request.to, slug: request.slug },
    props: { comparison: compareTopics(topics, PRODUCTS, request) },
  }));
}
const { comparison } = Astro.props;
const { request } = comparison;
const statusLabels = {
  added: "Added in target edition",
  absent: "Absent from target edition",
  changed: "Changed",
  unchanged: "Unchanged",
  none: "None in either edition",
};
---

<BaseLayout
  title={`Compare ${request.from} to ${request.to}: ${request.slug}`}
  description="Compare exact versioned documentation, warnings and applicability without merging procedures."
>
  <section class="page-intro">
    <p class="eyebrow">Edition comparison · synthetic documentation</p>
    <h1>
      {comparison.product.name}: {request.from} → {request.to}
    </h1>
    <p class="lead">Topic: {request.slug}. Compare source editions; do not mix their procedures.</p>
    <p>
      <a href="/compare/">Choose another comparison</a> ·{" "}
      <a href={comparisonUrl({ ...request, from: request.to, to: request.from })}>
        Reverse comparison
      </a>
    </p>
    <aside class="version-banner" aria-label="Comparison interpretation">
      <strong>Applicability must be reviewed separately.</strong>
      <p>
        A reused topic or diagnostic identifier can mean something different in another version. An
        absent section or warning is not evidence that a feature or hazard no longer exists. Missing
        content is never filled from another edition.
      </p>
    </aside>
  </section>
  <section class="content-section" aria-labelledby="comparison-changes-heading">
    <h2 id="comparison-changes-heading">Documentation changes</h2>
    {comparison.before === undefined || comparison.after === undefined ? (
      <p>One edition has no matching topic. The documented side remains available below.</p>
    ) : (
      <p>
        Title or summary: {comparison.summaryChanged ? "Changed" : "Unchanged"}. Identifiers:{" "}
        {comparison.identifiersChanged ? "Changed" : "Unchanged"}. Section order:{" "}
        {comparison.sectionOrderChanged ? "Changed" : "Unchanged"}.
      </p>
    )}
    <ul class="comparison-changes">
      {comparison.sections.map((section) => (
        <li>
          <strong>{section.after?.title ?? section.before?.title}</strong>:{" "}
          {statusLabels[section.status]}.
          <span data-warning-status={section.warningStatus}>
            {" "}
            Warning: {statusLabels[section.warningStatus]}.
          </span>
          {section.warningStatus === "absent" && (
            <p class="warning-absence">
              Warning absent from target documentation; no risk resolution is implied. Review the
              complete notice in the source column.
            </p>
          )}
          <div class="comparison-source-links">
            {section.before && <a href={`#from-${section.id}`}>From {request.from} section</a>}
            {section.after && <a href={`#to-${section.id}`}>To {request.to} section</a>}
          </div>
        </li>
      ))}
    </ul>
  </section>
  <div class="comparison-grid content-section">
    <ComparisonEdition
      product={comparison.product}
      version={comparison.fromVersion}
      topic={comparison.before}
      side="from"
    />
    <ComparisonEdition
      product={comparison.product}
      version={comparison.toVersion}
      topic={comparison.after}
      side="to"
    />
  </div>
</BaseLayout>
