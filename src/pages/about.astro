import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="Scope, evidence, safety, and accessibility boundaries for this independent portfolio demonstration."
>
  <article class="prose-page">
    <p class="eyebrow">Independent engineering demonstration</p>
    <h1>Scope and evidence</h1>
    <p>
      This site uses invented product names, identifiers, procedures, and source records. It is not
      operating guidance for real equipment and does not imply endorsement by any manufacturer.
    </p>
    <h2>What the portal demonstrates</h2>
    <ul>
      <li>
        Static-first delivery with validated content contracts and stable version-qualified URLs.
      </li>
      <li>
        Deterministic lexical retrieval, exact identifier boosts, reviewed synonyms, and a judged
        query set.
      </li>
      <li>
        Visible lifecycle, provenance, warning structure, keyboard operation, responsive reflow, and
        automated accessibility checks.
      </li>
      <li>
        An extractive answer preview that cites sources and abstains instead of inventing an answer.
      </li>
    </ul>
    <h2>Important limits</h2>
    <p>
      Automated accessibility testing cannot prove conformance. Search metrics describe only the
      included synthetic corpus and judgment set. The answer preview is not a generative AI system
      and should not be used for safety decisions.
    </p>
  </article>
</BaseLayout>
