---
/**
 * Assemble validated topics into the interactive version-filtered search page.
 *
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - variable documents: line 16
 * @@SYMBOL_INDEX_END
 */

import { getCollection } from "astro:content";
import SearchPanel from "../../components/SearchPanel.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { toSearchDocument, toTopicDocument } from "../../lib/content";

const documents = (await getCollection("topics"))
  .map(toTopicDocument)
  .map(toSearchDocument)
  .sort((left, right) => left.id.localeCompare(right.id, "en-US"));
---

<BaseLayout
  title="Search"
  description="Search synthetic product documentation with explicit product and version filters."
>
  <section class="page-intro">
    <p class="eyebrow">Evaluated lexical retrieval</p>
    <h1>Search exact identifiers and natural-language tasks</h1>
    <p>
      Results use a deterministic BM25-style score with reviewed synonyms and product/version
      filters.
    </p>
  </section>
  <SearchPanel documents={documents} />
</BaseLayout>
