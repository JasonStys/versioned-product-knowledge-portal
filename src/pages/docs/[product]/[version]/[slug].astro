---
/**
 * Generate semantic versioned topic pages with warnings and provenance evidence.
 *
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - interface Props: line 22
 * - function getStaticPaths: line 26
 * @@SYMBOL_INDEX_END
 */

import { getCollection } from "astro:content";
import LifecycleBadge from "../../../../components/LifecycleBadge.astro";
import VersionBanner from "../../../../components/VersionBanner.astro";
import TopicSections from "../../../../components/TopicSections.astro";
import { PRODUCTS } from "../../../../data/products";
import { comparisonUrl } from "../../../../lib/comparison";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { toTopicDocument } from "../../../../lib/content";
import type { TopicDocument } from "../../../../lib/contracts";

interface Props {
  topic: TopicDocument;
}

export async function getStaticPaths() {
  const topics = (await getCollection("topics")).map(toTopicDocument);
  return topics.map((topic) => ({
    params: { product: topic.productId, version: topic.version, slug: topic.topicSlug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
---

<BaseLayout title={topic.title} description={topic.summary}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/products/">Products</a>
    <span aria-hidden="true">/</span>
    <a href={`/products/${topic.productId}/${topic.version}/`}>
      {topic.productName} {topic.version}
    </a>
    <span aria-hidden="true">/</span>
    <span>{topic.title}</span>
  </nav>
  <article class="documentation-topic" data-pagefind-body>
    <header class="topic-header">
      <p class="eyebrow">{topic.contentType}</p>
      <h1>{topic.title}</h1>
      <p class="lead">{topic.summary}</p>
      <div class="topic-qualifiers">
        <LifecycleBadge lifecycle={topic.lifecycle} />
        <span>
          {topic.productName} {topic.version}
        </span>
        <span>
          Updated <time datetime={topic.updated}>{topic.updated}</time>
        </span>
      </div>
    </header>
    <VersionBanner
      productName={topic.productName}
      version={topic.version}
      lifecycle={topic.lifecycle}
    />
    <nav class="on-this-page" aria-label="On this page">
      <strong>On this page</strong>
      <ul>
        {topic.sections.map((section) => (
          <li>
            <a href={`#${section.id}`}>{section.title}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="on-this-page" aria-label="Compare this topic">
      <strong>Compare this topic in another edition</strong>
      <ul>
        {PRODUCTS.find((product) => product.id === topic.productId)
          ?.versions.filter((version) => version.version !== topic.version)
          .map((version) => (
            <li>
              <a
                href={comparisonUrl({
                  productId: topic.productId,
                  from: topic.version,
                  to: version.version,
                  slug: topic.topicSlug,
                })}
              >
                Compare with {version.version} ({version.lifecycle})
              </a>
            </li>
          ))}
      </ul>
    </nav>
    <TopicSections sections={topic.sections} />
    <footer class="provenance">
      <h2>Source evidence</h2>
      <dl>
        <div>
          <dt>Source ID</dt>
          <dd>
            <code>{topic.provenance.sourceId}</code>
          </dd>
        </div>
        <div>
          <dt>Pages</dt>
          <dd>{topic.provenance.pages.join(", ")}</dd>
        </div>
        <div>
          <dt>Checksum</dt>
          <dd>
            <code>{topic.provenance.checksum}</code>
          </dd>
        </div>
      </dl>
    </footer>
  </article>
</BaseLayout>
