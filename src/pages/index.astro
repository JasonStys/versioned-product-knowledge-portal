---
/**
 * Present the portal value proposition, product catalog, and current topics.
 *
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - variable topics: line 17
 * @@SYMBOL_INDEX_END
 */

import { getCollection } from "astro:content";
import TopicCard from "../components/TopicCard.astro";
import { PRODUCTS } from "../data/products";
import BaseLayout from "../layouts/BaseLayout.astro";
import { toTopicDocument } from "../lib/content";

const topics = (await getCollection("topics"))
  .map(toTopicDocument)
  .filter((topic) => topic.lifecycle === "current")
  .sort((left, right) => left.title.localeCompare(right.title, "en-US"));
---

<BaseLayout
  title="Version-aware industrial documentation"
  description="A static-first product knowledge portal with accessible navigation, version filters, evaluated lexical search, citations, and abstention."
>
  <section class="hero">
    <p class="eyebrow">Synthetic product knowledge · measured search</p>
    <h1>Find the right procedure for the right version.</h1>
    <p class="hero-copy">
      Relay keeps diagnostic codes, procedures, lifecycle status, and source evidence attached to an
      explicit product version—then tests search quality before publication.
    </p>
    <div class="button-row">
      <a class="button button-primary" href="/search/">
        Search the portal
      </a>
      <a class="button button-secondary" href="/products/">
        Browse products
      </a>
    </div>
    <dl class="evidence-strip">
      <div>
        <dt>{PRODUCTS.length}</dt>
        <dd>Synthetic products</dd>
      </div>
      <div>
        <dt>{topics.length}</dt>
        <dd>Current topics</dd>
      </div>
      <div>
        <dt>50</dt>
        <dd>Judged search queries</dd>
      </div>
      <div>
        <dt>Static</dt>
        <dd>Public delivery</dd>
      </div>
    </dl>
  </section>

  <section class="content-section" aria-labelledby="design-heading">
    <div class="section-heading">
      <p class="eyebrow">Designed for correctness</p>
      <h2 id="design-heading">Version context is part of every answer</h2>
    </div>
    <div class="feature-grid">
      <article>
        <h3>Exact identifiers</h3>
        <p>Error codes, model IDs, and register names receive deterministic boosts.</p>
      </article>
      <article>
        <h3>Lifecycle visibility</h3>
        <p>Current, maintained, and retired material is labeled with text—not color alone.</p>
      </article>
      <article>
        <h3>Cited abstention</h3>
        <p>The answer preview cites versioned sources or says that evidence is insufficient.</p>
      </article>
    </div>
  </section>

  <section class="content-section" aria-labelledby="latest-heading">
    <div class="section-heading">
      <p class="eyebrow">Current versions</p>
      <h2 id="latest-heading">Start with a task</h2>
    </div>
    <div class="card-grid">
      {topics.slice(0, 6).map((topic) => (
        <TopicCard topic={topic} />
      ))}
    </div>
  </section>
</BaseLayout>
