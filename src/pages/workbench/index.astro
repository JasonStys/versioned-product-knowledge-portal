---
/**
 * Expose the actual catalog authoring, search, comparison and revision workspace.
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - variable starter: line 13
 * @@SYMBOL_INDEX_END
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PRODUCTS } from "../../data/products";
import { toTopicDocument } from "../../lib/content";
const starter = {
  schemaVersion: 1,
  products: PRODUCTS,
  topics: (await getCollection("topics")).map(toTopicDocument),
};
---

<BaseLayout
  title="Catalog workspace"
  description="Author, validate, compare and search a versioned documentation catalog with local revision history."
>
  <section class="page-intro workspace-intro">
    <p class="eyebrow">Versioned Product Knowledge Portal · Jason Stys</p>
    <h1>Catalog workspace</h1>
    <p>
      Keep products, editions, structured warnings and source references together. Search and
      compare the catalog you are actually editing.
    </p>
    <p id="workspace-mode">Loading the validated catalog…</p>
    <div class="workspace-actions">
      <button id="save-catalog" type="button">
        Save revision
      </button>
      <button id="import-catalog" type="button">
        Import JSON catalog
      </button>
      <button id="export-catalog" type="button">
        Export saved JSON
      </button>
      <button id="export-html" type="button">
        Export saved HTML
      </button>
      <button id="quit-workspace" type="button">
        Exit application
      </button>
    </div>
    <p id="workspace-status" role="status" aria-live="polite">
      Initializing…
    </p>
    <p id="workspace-error" role="alert" hidden></p>
  </section>
  <div class="workspace-shell">
    <nav class="workspace-tabs" aria-label="Workspace sections">
      <button type="button" data-panel="authoring" aria-pressed="true">
        Catalog &amp; authoring
      </button>
      <button type="button" data-panel="research" aria-pressed="false">
        Search &amp; compare
      </button>
      <button type="button" data-panel="history" aria-pressed="false">
        History &amp; help
      </button>
    </nav>
    <section id="authoring" class="workspace-panel">
      <div class="workspace-grid">
        <div class="workspace-card">
          <h2>Products &amp; editions</h2>
          <label for="product-select">Product</label>
          <select id="product-select"></select>
          <form id="product-form">
            <label for="product-id">Stable product ID</label>
            <input id="product-id" required maxlength="128" />
            <label for="product-name">Product name</label>
            <input id="product-name" required maxlength="90" />
            <label for="product-description">Description</label>
            <textarea id="product-description" required maxlength="400" rows="3"></textarea>
            <div class="workspace-actions">
              <button type="submit">Apply product details</button>
              <button id="new-product" type="button">
                New product
              </button>
            </div>
          </form>
          <h3>Edition lifecycle</h3>
          <form id="version-form">
            <label for="version-value">Edition (major.minor)</label>
            <input id="version-value" placeholder="2.1" required maxlength="13" />
            <label for="version-lifecycle">Lifecycle</label>
            <select id="version-lifecycle">
              <option value="maintained">Maintained</option>
              <option value="current">Current</option>
              <option value="retired">Retired</option>
            </select>
            <label for="version-release">Release date</label>
            <input id="version-release" type="date" required />
            <label for="version-end">End of support (required for retired)</label>
            <input id="version-end" type="date" />
            <label for="version-clone">Copy topics from (new edition only)</label>
            <select id="version-clone">
              <option value="">No topic copy</option>
            </select>
            <button type="submit">Apply edition</button>
          </form>
          <p>
            Promoting a current edition maintains the former current edition. Retirement preserves
            its content. Changing a source reference is an assertion, not verification of its
            document.
          </p>
        </div>
        <div class="workspace-card">
          <h2>Topic editor</h2>
          <label for="topic-select">Topic in selected product</label>
          <select id="topic-select"></select>
          <div class="workspace-actions">
            <button id="new-topic" type="button">
              New topic
            </button>
            <button id="delete-topic" type="button">
              Remove selected topic from draft
            </button>
          </div>
          <form id="topic-form">
            <label for="topic-title">Title</label>
            <input id="topic-title" required maxlength="90" />
            <label for="topic-summary">Summary</label>
            <textarea id="topic-summary" required maxlength="240" rows="3"></textarea>
            <label for="topic-json">Structured topic JSON</label>
            <p id="topic-json-help">
              Edit sections, steps, code, warning condition/consequence/avoidance, identifiers and
              source pages here. Stable IDs cannot change during an edit. All fields are validated
              together; incomplete warnings are refused.
            </p>
            <textarea
              id="topic-json"
              rows="18"
              spellcheck="false"
              aria-describedby="topic-json-help"
            ></textarea>
            <button type="submit">Validate &amp; apply topic</button>
          </form>
        </div>
      </div>
      <article class="workspace-card" id="topic-preview" aria-label="Exact draft topic preview">
        <h2>Draft preview</h2>
        <p>Select or create a topic.</p>
      </article>
    </section>
    <section id="research" class="workspace-panel" hidden>
      <div class="workspace-grid">
        <div class="workspace-card">
          <h2>Search this draft</h2>
          <form id="workspace-search">
            <label for="workspace-query">Words or exact diagnostic identifier</label>
            <input id="workspace-query" maxlength="160" required placeholder="E-104" />
            <label for="search-product">Product filter</label>
            <select id="search-product"></select>
            <label for="search-version">Edition filter</label>
            <select id="search-version"></select>
            <button type="submit">Search catalog</button>
          </form>
          <div id="workspace-answer" role="status"></div>
          <ol id="workspace-results"></ol>
        </div>
        <div class="workspace-card">
          <h2>Compare exact editions</h2>
          <form id="workspace-compare">
            <label for="compare-request">Stable topic and edition pair</label>
            <select id="compare-request"></select>
            <button type="submit">Compare sources</button>
          </form>
          <div id="workspace-comparison"></div>
          <p>
            Absent sections and warnings are shown explicitly. The comparison never combines
            procedures or treats a missing warning as a resolved hazard.
          </p>
        </div>
      </div>
    </section>
    <section id="history" class="workspace-panel" hidden>
      <div class="workspace-card">
        <h2>Saved revision history</h2>
        <p>
          Restore creates a new revision. It does not delete later history. Fifty revisions and a
          bounded catalog are retained; export before starting another workspace.
        </p>
        <ol id="revision-history"></ol>
      </div>
      <div class="workspace-card">
        <h2>Use &amp; scope</h2>
        <ol>
          <li>
            Select a product and topic. Edit its structured fields, then choose Validate &amp; apply
            topic.
          </li>
          <li>
            Create an edition and optionally copy a known edition’s topics. Search, compare and
            preview your draft before saving.
          </li>
          <li>
            Save revision to commit the complete validated catalog. Import replaces the draft only;
            save it explicitly. Exports contain the last saved catalog.
          </li>
          <li>
            Restore a prior revision to create a new saved revision. Canceling a dialog makes no
            changes. Exit waits for accepted file work; unsaved drafts require confirmation.
          </li>
        </ol>
        <p>
          Native catalogs are plaintext in an owner-local workspace outside the application. This is
          one trusted operating-system owner, with no login, encryption, remote publishing, provider
          or production equipment connection. The original starter content is synthetic and is not
          operating guidance for real equipment.
        </p>
        <p>
          Catalog visibility “public” denotes intended publication metadata. Nothing is uploaded.
          Local hashes detect accidental changes and supplied provenance remains an assertion.
          Static alias checks do not defeat a malicious concurrent operating-system owner.
        </p>
        <p id="native-identity">Browser preview has no durable native workspace.</p>
        <details>
          <summary>Runtime notices</summary>
          <pre id="native-notices">Not packaged in browser preview.</pre>
        </details>
        <p>
          Created by Jason Stys. Contact: github.com/JasonStys. External links are not opened
          automatically by the desktop app.
        </p>
      </div>
    </section>
  </div>
  <script
    is:inline
    id="starter-catalog"
    type="application/json"
    set:html={JSON.stringify(starter).replace(/</gu, "\\u003c")}
  ></script>
  <script>
    import "../../scripts/workbench";
  </script>
</BaseLayout>
