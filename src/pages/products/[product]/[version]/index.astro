---
/**
 * Generate each product/version landing page and its applicable topic list.
 *
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - interface Props: line 21
 * - function getStaticPaths: line 27
 * @@SYMBOL_INDEX_END
 */

import { getCollection } from "astro:content";
import LifecycleBadge from "../../../../components/LifecycleBadge.astro";
import TopicCard from "../../../../components/TopicCard.astro";
import VersionBanner from "../../../../components/VersionBanner.astro";
import { PRODUCTS } from "../../../../data/products";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { toTopicDocument } from "../../../../lib/content";
import type { Product, ProductVersion, TopicDocument } from "../../../../lib/contracts";

interface Props {
  product: Product;
  selectedVersion: ProductVersion;
  topics: readonly TopicDocument[];
}

export async function getStaticPaths() {
  const topics = (await getCollection("topics")).map(toTopicDocument);
  return PRODUCTS.flatMap((product) =>
    product.versions.map((selectedVersion) => ({
      params: { product: product.id, version: selectedVersion.version },
      props: {
        product,
        selectedVersion,
        topics: topics
          .filter(
            (topic) => topic.productId === product.id && topic.version === selectedVersion.version,
          )
          .sort((left, right) => left.title.localeCompare(right.title, "en-US")),
      },
    })),
  );
}

const { product, selectedVersion, topics } = Astro.props;
---

<BaseLayout title={`${product.name} ${selectedVersion.version}`} description={product.description}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/products/">Products</a>
    <span aria-hidden="true">/</span>
    <span>
      {product.name} {selectedVersion.version}
    </span>
  </nav>
  <section class="page-intro">
    <p class="eyebrow">Product documentation</p>
    <h1>
      {product.name} {selectedVersion.version}
    </h1>
    <LifecycleBadge lifecycle={selectedVersion.lifecycle} />
    <p>{product.description}</p>
  </section>
  <VersionBanner
    productName={product.name}
    version={selectedVersion.version}
    lifecycle={selectedVersion.lifecycle}
  />
  <section class="content-section" aria-labelledby="topics-heading">
    <h2 id="topics-heading">Topics for this version</h2>
    {topics.length === 0 ? (
      <p>No public topics are available for this version.</p>
    ) : (
      <div class="card-grid">
        {topics.map((topic) => (
          <TopicCard topic={topic} />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
