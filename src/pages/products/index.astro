---
/**
 * List synthetic products and every lifecycle-qualified documentation version.
 *
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - no top-level symbols
 * @@SYMBOL_INDEX_END
 */

import LifecycleBadge from "../../components/LifecycleBadge.astro";
import { PRODUCTS } from "../../data/products";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Products"
  description="Browse product documentation by explicit software version and lifecycle status."
>
  <section class="page-intro">
    <p class="eyebrow">Product catalog</p>
    <h1>Choose a product and version</h1>
    <p>
      Version selection stays visible so reused diagnostic identifiers cannot silently cross
      releases.
    </p>
  </section>
  <section class="content-section product-grid" aria-label="Synthetic products">
    {PRODUCTS.map((product) => (
      <article class="product-card">
        <h2>{product.name}</h2>
        <p>{product.description}</p>
        <ul class="version-list">
          {product.versions.map((version) => (
            <li>
              <a href={`/products/${product.id}/${version.version}/`}>Version {version.version}</a>
              <LifecycleBadge lifecycle={version.lifecycle} />
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>
</BaseLayout>
