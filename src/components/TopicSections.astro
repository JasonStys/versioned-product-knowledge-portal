---
/**
 * Render exact authored sections with explicit heading depth and unique comparison anchor prefixes.
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - interface Props: line 12
 * - variable Heading: line 18
 * @@SYMBOL_INDEX_END
 */
import WarningNotice from "./WarningNotice.astro";
import type { TopicSection } from "../lib/contracts";
interface Props {
  sections: readonly TopicSection[];
  prefix?: string;
  headingLevel?: 2 | 3;
}
const { sections, prefix = "", headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

{sections.map((section) => (
  <section id={`${prefix}${section.id}`} class="topic-section">
    <Heading>{section.title}</Heading>
    {section.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    {section.warning && (
      <WarningNotice warning={section.warning} headingLevel={headingLevel === 2 ? 3 : 4} />
    )}
    {section.steps && (
      <ol>
        {section.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    )}
    {section.code && <pre tabindex="0"><code>{section.code}</code></pre>}
  </section>
))}
