---
/**
 * Provide search controls, live status, ranked results, and cited answer output.
 *
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - interface Props: line 17
 * - variable serializedDocuments: line 22
 * - variable products: line 23
 * - variable versionLabels: line 24
 * @@SYMBOL_INDEX_END
 */

import { PRODUCTS } from "../data/products";
import type { Product, SearchDocument } from "../lib/contracts";

interface Props {
  documents: readonly SearchDocument[];
}

const { documents } = Astro.props;
const serializedDocuments = JSON.stringify(documents).replaceAll("<", "\\u003c");
const products: readonly Product[] = PRODUCTS;
const versionLabels = [
  ...new Set(products.flatMap((product) => product.versions.map((version) => version.version))),
];
---

<section class="search-panel" data-search-root>
  <div class="search-controls">
    <label for="knowledge-search">Search documentation</label>
    <input
      id="knowledge-search"
      data-search-input
      type="search"
      maxlength="160"
      placeholder="Try E-104, calibration, or certificate rotation"
      autocomplete="off"
    />
    <div class="filter-grid">
      <label>
        Product
        <select data-product-filter>
          <option value="">All products</option>
          {PRODUCTS.map((product) => (
            <option value={product.id}>{product.name}</option>
          ))}
        </select>
      </label>
      <label>
        Version
        <select data-version-filter>
          <option value="">All versions</option>
          {versionLabels.map((version) => (
            <option value={version}>{version}</option>
          ))}
        </select>
      </label>
    </div>
  </div>

  <p class="search-status" data-search-status aria-live="polite">
    Enter a search term.
  </p>
  <div class="search-grid">
    <section aria-labelledby="ranked-results-heading">
      <h2 id="ranked-results-heading">Ranked results</h2>
      <div data-search-results>
        <p>Search results appear here.</p>
      </div>
    </section>
    <aside class="answer-panel" aria-labelledby="grounded-answer-heading">
      <p class="eyebrow">Experimental · extractive</p>
      <h2 id="grounded-answer-heading">Grounded answer</h2>
      <p class="answer-explainer">
        This mode only repeats a version-matched source summary and cites it. It abstains when
        relevance is too low.
      </p>
      <div data-grounded-answer aria-live="polite">
        <p>Enter a question first.</p>
      </div>
    </aside>
  </div>
  <script
    is:inline
    type="application/json"
    data-search-documents
    set:html={serializedDocuments}
  ></script>
</section>

<script>
  import type { SearchDocument } from "../lib/contracts";
  import { initializeSearch } from "../lib/search-client";

  for (const root of document.querySelectorAll<HTMLElement>("[data-search-root]")) {
    const source = root.querySelector<HTMLScriptElement>("[data-search-documents]");
    if (source?.textContent !== null && source?.textContent !== undefined) {
      const documents = JSON.parse(source.textContent) as readonly SearchDocument[];
      initializeSearch(root, documents);
    }
  }
</script>
