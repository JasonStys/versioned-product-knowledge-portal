---
/**
 * Keep one edition's applicability, complete text/warnings and provenance isolated from the other edition.
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - interface Props: line 14
 * @@SYMBOL_INDEX_END
 */
import type { Product, ProductVersion, TopicDocument } from "../lib/contracts";
import { topicUrl } from "../lib/content";
import LifecycleBadge from "./LifecycleBadge.astro";
import VersionBanner from "./VersionBanner.astro";
import TopicSections from "./TopicSections.astro";
interface Props {
  product: Product;
  version: ProductVersion;
  topic: TopicDocument | undefined;
  side: "from" | "to";
}
const { product, version, topic, side } = Astro.props;
---

<article class="comparison-edition" aria-labelledby={`${side}-edition-heading`} data-edition={side}>
  <h2 id={`${side}-edition-heading`}>
    {side === "from" ? "From" : "To"}: {product.name} {version.version}
  </h2>
  <LifecycleBadge lifecycle={version.lifecycle} />
  <VersionBanner
    productName={product.name}
    version={version.version}
    lifecycle={version.lifecycle}
  />
  {topic === undefined ? (
    <p class="missing-topic">
      This topic is not documented in this edition. No procedure or product capability is inferred.
    </p>
  ) : (
    <>
      <p class="eyebrow">
        {topic.contentType} · <time datetime={topic.updated}>Updated {topic.updated}</time>
      </p>
      <h3>{topic.title}</h3>
      <p>{topic.summary}</p>
      <p>
        Identifiers: {topic.identifiers.length === 0 ? "None listed" : topic.identifiers.join(", ")}
      </p>
      <p>
        <a href={topicUrl(topic)}>Read canonical {version.version} source</a>
      </p>
      <TopicSections sections={topic.sections} prefix={`${side}-`} headingLevel={3} />
      <div class="provenance">
        <h3>Source evidence: {version.version}</h3>
        <dl>
          <div>
            <dt>Source ID</dt>
            <dd>{topic.provenance.sourceId}</dd>
          </div>
          <div>
            <dt>Pages</dt>
            <dd>{topic.provenance.pages.join(", ")}</dd>
          </div>
          <div>
            <dt>Checksum</dt>
            <dd>
              <code>{topic.provenance.checksum}</code>
            </dd>
          </div>
        </dl>
      </div>
    </>
  )}
</article>
