---
/**
 * Render lifecycle state with text and an accessible non-color-only marker.
 *
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - interface Props: line 14
 * - variable labels: line 19
 * @@SYMBOL_INDEX_END
 */

import type { Lifecycle } from "../lib/contracts";

interface Props {
  lifecycle: Lifecycle;
}

const { lifecycle } = Astro.props;
const labels: Record<Lifecycle, string> = {
  current: "Current",
  maintained: "Maintained",
  retired: "Retired",
};
---

<span class:list={["lifecycle-badge", `lifecycle-${lifecycle}`]}>
  <span aria-hidden="true">
    {lifecycle === "current" ? "●" : lifecycle === "maintained" ? "◆" : "■"}
  </span>
  {labels[lifecycle]}
</span>
