---
/**
 * Present a complete safety notice with condition, consequence, and avoidance.
 *
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - interface Props: line 14
 * - variable Heading: line 20
 * @@SYMBOL_INDEX_END
 */

import type { WarningNotice } from "../lib/contracts";

interface Props {
  warning: WarningNotice;
  headingLevel?: 3 | 4;
}

const { warning, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h4";
---

<aside
  class:list={["warning-notice", `warning-${warning.level}`]}
  aria-label={`${warning.level} notice`}
>
  <Heading>{warning.level.toUpperCase()}</Heading>
  <dl>
    <div>
      <dt>Condition</dt>
      <dd>{warning.condition}</dd>
    </div>
    <div>
      <dt>Consequence</dt>
      <dd>{warning.consequence}</dd>
    </div>
    <div>
      <dt>Avoidance</dt>
      <dd>{warning.avoidance}</dd>
    </div>
  </dl>
</aside>
