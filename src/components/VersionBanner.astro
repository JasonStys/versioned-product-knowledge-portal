---
/**
 * Warn when a reader is viewing maintained or retired versioned content.
 *
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - interface Props: line 13
 * @@SYMBOL_INDEX_END
 */

import type { Lifecycle } from "../lib/contracts";

interface Props {
  productName: string;
  version: string;
  lifecycle: Lifecycle;
}

const { productName, version, lifecycle } = Astro.props;
---

{lifecycle !== "current" && (
  <aside class:list={["version-banner", `version-banner-${lifecycle}`]} aria-label="Version status">
    <strong>{lifecycle === "retired" ? "Retired documentation" : "Maintained version"}</strong>
    <p>
      You are reading {productName} {version}. Confirm the installed version before following a
      procedure or interpreting a diagnostic code.
    </p>
  </aside>
)}
