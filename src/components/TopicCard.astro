---
/**
 * Summarize one version-qualified topic for navigation and search discovery.
 *
 * Symbol index (generated by tools/update-symbol-index.ts):
 * @@SYMBOL_INDEX_START
 * - interface Props: line 15
 * @@SYMBOL_INDEX_END
 */

import type { TopicDocument } from "../lib/contracts";
import { topicUrl } from "../lib/content";
import LifecycleBadge from "./LifecycleBadge.astro";

interface Props {
  topic: TopicDocument;
}

const { topic } = Astro.props;
---

<article class="topic-card">
  <div class="card-heading">
    <p class="eyebrow">{topic.contentType}</p>
    <LifecycleBadge lifecycle={topic.lifecycle} />
  </div>
  <h3>
    <a href={topicUrl(topic)}>{topic.title}</a>
  </h3>
  <p>{topic.summary}</p>
  <p class="topic-meta">
    {topic.productName} {topic.version}
  </p>
</article>
